OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Postgres with pgvector (local or hosted, e.g. Supabase)
DATABASE_URL=postgres://hr:hr@localhost:5434/hr_agent

JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
JWT_TTL_HOURS=24
ENVIRONMENT=development

PORT=3004
# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGINS=http://localhost:3000

DEFAULT_TEMPERATURE=0.2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=5
SIMILARITY_FLOOR=0.25
MAX_UPLOAD_BYTES=10485760
CHAT_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=30
MAX_UPLOADS_PER_DAY=20
MAX_UPLOAD_BYTES_PER_DAY=52428800
SEED_ON_START=true
